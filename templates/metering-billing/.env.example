# ---- Metering + billing template ----
# Copy these into your app's .env / Vercel project env vars.

# Branding / plans (all optional — sensible defaults in billing.config.ts)
BILLING_APP_NAME=My App
BILLING_FREE_RUNS=10
BILLING_PRO_RUNS=500
BILLING_PRO_PRICE_USD=49
# Optional: override the upgrade URL returned in 402 responses.
# Defaults to <origin>/api/billing/plans
# BILLING_UPGRADE_URL=https://myapp.com/pricing

# Durable usage storage (Supabase). Without these, usage is kept in
# memory only (fine for local dev, lost between serverless invocations).
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Stripe (get these from https://dashboard.stripe.com)
# Without STRIPE_SECRET_KEY the billing routes answer 501 and the
# paywall stays open — the app keeps working.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# npm dependency to add:
#   npm install stripe
