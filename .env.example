# Vercel AI Gateway key. Leave empty to run in mock mode (no spend, no keys).
AI_GATEWAY_API_KEY=
# When true (or when no key is set), the gateway returns scripted responses.
MOCK_MODE=true
# Local JSON hub storage directory (defaults to ./data).
DATA_DIR=
# Local JSON knowledge base directory (zero-key Context Engine). Example: ./data/kb
ROSTR_KB_PATH=
# Local brain-library storage root (session memory: storage/index.json +
# storage/sessions/<project>/<id>.md). Defaults to ./storage.
ROSTR_STORAGE_PATH=./storage
# Always-on session-memory trigger loop.
# Checkpoint when emitted context tokens reach this % of the model window.
CONTEXT_CHECKPOINT_TOKENS_PCT=75
# Checkpoint when a run has been streaming this many minutes.
CONTEXT_CHECKPOINT_MINUTES=30
# Master switch for the session-memory background loop (false disables it).
CONTEXT_BACKGROUND=true
# Set both to use Supabase instead of the JSON hub.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: required for the Context Engine KB tables (bypasses RLS).
SUPABASE_SERVICE_KEY=
# Stripe (used by billing routes; not required for the core runtime).
STRIPE_SECRET_KEY=
# Project API keys + Supabase JWTs are verified when SUPABASE_URL is set.
# Without it, the API runs in local dev mode (no auth required).
ROSTR_DEV_API_KEY=
# Composio: real integrations (Gmail, Calendar, Drive, Slack...).
# Unset = integrations report "not configured", runs continue without them.
COMPOSIO_API_KEY=
# Cron secret for the daily compression pass. The Vercel cron job URL must
# include ?cron_secret=<this value> — set it in the Vercel dashboard's cron
# job URL, not in vercel.json, so the secret never lands in the repo.
CRON_SECRET=
