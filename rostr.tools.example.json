  {
    "name": "github_repo",
    "kind": "http",
    "description": "Look up a GitHub repo by {owner}/{repo}",
    "url": "https://api.github.com/repos/{owner}/{repo}"
  },
  {
    "name": "apify_run_actor",
    "kind": "http",
    "description": "Run an Apify actor (needs your own Apify account/key)",
