        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst startTs = new Date(now.getTime() - 24 * 60 * 60 * 1000).getTime();\nconst endTs = now.getTime();\n\nreturn items.map(item => {\n  const payload = item.json.body || item.json;\n  return {\n    json: {\n      ...payload,\n      startTs,\n      endTs,\n      ingest_timestamp: now.toISOString(),\n      company_source: 'OnTheStage_gtm_engine'\n    }\n  };\n});"
